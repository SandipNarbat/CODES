#!/bin/bash

# Helper: only scp a file if it exists, is non-empty, and its size
# has stopped changing (i.e. nothing is currently writing to it).
copy_if_stable() {
    local src="$1"
    local dest="$2"

    # #2: must exist and be non-empty
    if [ ! -s "$src" ]; then
        echo "skip (missing/empty): $src"
        return
    fi

    # #3: must be stable (size unchanged after a short pause)
    local size1 size2
    size1=$(stat -c %s "$src" 2>/dev/null)
    sleep 1
    size2=$(stat -c %s "$src" 2>/dev/null)

    if [ -z "$size1" ] || [ -z "$size2" ] || [ "$size1" != "$size2" ]; then
        echo "skip (still being written): $src"
        return
    fi

    scp -P 3000 "$src" "$dest"
}

